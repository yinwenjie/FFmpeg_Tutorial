From 5e6894a995d694f49078caa43055267819502558 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 20:59:04 +0000
Subject: [PATCH] doc/examples/transcode: fix buffersink option names

The buffersink options pix_fmts, sample_fmts, ch_layouts and
sample_rates no longer exist, so the example fails while setting up
the filter graph:

    Cannot set output pixel format
    Error occurred: Option not found

Set the array-type options pixel_formats, sample_formats,
channel_layouts and samplerates with av_opt_set_array() instead.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 doc/examples/transcode.c | 24 ++++++++++++------------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/doc/examples/transcode.c b/doc/examples/transcode.c
index 5cad3e1..cf094d4 100644
--- a/doc/examples/transcode.c
+++ b/doc/examples/transcode.c
@@ -305,9 +305,9 @@ static int init_filter(FilteringContext* fctx, AVCodecContext *dec_ctx,
             goto end;
         }
 
-        ret = av_opt_set_bin(buffersink_ctx, "pix_fmts",
-                (uint8_t*)&enc_ctx->pix_fmt, sizeof(enc_ctx->pix_fmt),
-                AV_OPT_SEARCH_CHILDREN);
+        ret = av_opt_set_array(buffersink_ctx, "pixel_formats",
+                AV_OPT_SEARCH_CHILDREN, 0, 1,
+                AV_OPT_TYPE_PIXEL_FMT, &enc_ctx->pix_fmt);
         if (ret < 0) {
             av_log(NULL, AV_LOG_ERROR, "Cannot set output pixel format\n");
             goto end;
@@ -350,25 +350,25 @@ static int init_filter(FilteringContext* fctx, AVCodecContext *dec_ctx,
             goto end;
         }
 
-        ret = av_opt_set_bin(buffersink_ctx, "sample_fmts",
-                (uint8_t*)&enc_ctx->sample_fmt, sizeof(enc_ctx->sample_fmt),
-                AV_OPT_SEARCH_CHILDREN);
+        ret = av_opt_set_array(buffersink_ctx, "sample_formats",
+                AV_OPT_SEARCH_CHILDREN, 0, 1,
+                AV_OPT_TYPE_SAMPLE_FMT, &enc_ctx->sample_fmt);
         if (ret < 0) {
             av_log(NULL, AV_LOG_ERROR, "Cannot set output sample format\n");
             goto end;
         }
 
-        av_channel_layout_describe(&enc_ctx->ch_layout, buf, sizeof(buf));
-        ret = av_opt_set(buffersink_ctx, "ch_layouts",
-                         buf, AV_OPT_SEARCH_CHILDREN);
+        ret = av_opt_set_array(buffersink_ctx, "channel_layouts",
+                AV_OPT_SEARCH_CHILDREN, 0, 1,
+                AV_OPT_TYPE_CHLAYOUT, &enc_ctx->ch_layout);
         if (ret < 0) {
             av_log(NULL, AV_LOG_ERROR, "Cannot set output channel layout\n");
             goto end;
         }
 
-        ret = av_opt_set_bin(buffersink_ctx, "sample_rates",
-                (uint8_t*)&enc_ctx->sample_rate, sizeof(enc_ctx->sample_rate),
-                AV_OPT_SEARCH_CHILDREN);
+        ret = av_opt_set_array(buffersink_ctx, "samplerates",
+                AV_OPT_SEARCH_CHILDREN, 0, 1,
+                AV_OPT_TYPE_INT, &enc_ctx->sample_rate);
         if (ret < 0) {
             av_log(NULL, AV_LOG_ERROR, "Cannot set output sample rate\n");
             goto end;
-- 
