From 245326f1f2ee2336b5551d5b75f580220be132b7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 21:39:49 +0000
Subject: [PATCH] doc/examples/remux: copy metadata and dispositions

Only the codec parameters of each stream were copied to the output.
The global metadata, the stream metadata and the stream dispositions
were lost, so a remuxed file had no title, no language tags and no
default track flags any more, e.g. when remuxing Matroska to Matroska:

  input:   stream 1: audio, disposition:default=1, language=chi
  output:  stream 1: audio, disposition:default=0

Copy them, which is also what "ffmpeg -c copy" does by default.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 doc/examples/remux.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/doc/examples/remux.c b/doc/examples/remux.c
index 78e2126..e377b2c 100644
--- a/doc/examples/remux.c
+++ b/doc/examples/remux.c
@@ -91,6 +91,12 @@ int main(int argc, char **argv)
         goto end;
     }
 
+    ret = av_dict_copy(&ofmt_ctx->metadata, ifmt_ctx->metadata, 0);
+    if (ret < 0) {
+        fprintf(stderr, "Failed to copy metadata\n");
+        goto end;
+    }
+
     stream_mapping_size = ifmt_ctx->nb_streams;
     stream_mapping = av_calloc(stream_mapping_size, sizeof(*stream_mapping));
     if (!stream_mapping) {
@@ -127,6 +133,13 @@ int main(int argc, char **argv)
             goto end;
         }
         out_stream->codecpar->codec_tag = 0;
+
+        ret = av_dict_copy(&out_stream->metadata, in_stream->metadata, 0);
+        if (ret < 0) {
+            fprintf(stderr, "Failed to copy stream metadata\n");
+            goto end;
+        }
+        out_stream->disposition = in_stream->disposition;
     }
     av_dump_format(ofmt_ctx, 0, out_filename, 1);
 
