next line.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 doc/examples/scale_video.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/doc/examples/scale_video.c b/doc/examples/scale_video.c
index c2fd161..62417cb 100644
--- a/doc/examples/scale_video.c
+++ b/doc/examples/scale_video.c
@@ -67,7 +67,7 @@ int main(int argc, char **argv)
         fprintf(stderr, "Usage: %s output_file output_size\n"
                 "API example program to show how to scale an image with libswscale.\n"
                 "This program generates a series of pictures, rescales them to the given "
-                "output_size and saves them to an output file named output_file\n."
+                "output_size and saves them to an output file named output_file.\n"
                 "\n", argv[0]);
         exit(1);
     }
