From f0f70c13b7a91b9cfbc901674fd9f1a7b3016a46 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 21:00:29 +0000
Subject: [PATCH] doc/examples: build avio_http_serve_files with "make
 examples"

doc/examples/Makefile tests CONFIG_AVIO_HTTP_SERVE_FILES, but the
variable generated by configure is CONFIG_AVIO_HTTP_SERVE_FILES_EXAMPLE.
The condition is therefore never true and the example is never built by
"make examples".

Fixing the Makefile alone would build the example on systems without
fork(), because its dependencies are declared in configure as
avio_http_serve_files_deps instead of avio_http_serve_files_example_deps
and are thus ignored. The same typo affects avio_list_dir and
avio_read_callback, which stay enabled even if libavformat is disabled.
Fix the three names as well.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 configure             | 6 +++---
 doc/examples/Makefile | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/configure b/configure
index 0db2edd..8d46df4 100755
--- a/configure
+++ b/configure
@@ -4310,9 +4310,9 @@ drawbox_vaapi_filter_deps="vaapi_1"
 whisper_filter_deps="avformat whisper"
 
 # examples
-avio_http_serve_files_deps="avformat avutil fork"
-avio_list_dir_deps="avformat avutil"
-avio_read_callback_deps="avformat avcodec avutil"
+avio_http_serve_files_example_deps="avformat avutil fork"
+avio_list_dir_example_deps="avformat avutil"
+avio_read_callback_example_deps="avformat avcodec avutil"
 decode_audio_example_deps="avcodec avutil"
 decode_filter_audio_example_deps="avfilter avcodec avformat avutil"
 decode_filter_video_example_deps="avfilter avcodec avformat avutil"
diff --git a/doc/examples/Makefile b/doc/examples/Makefile
index 0d8feb6..97cd164 100644
--- a/doc/examples/Makefile
+++ b/doc/examples/Makefile
@@ -1,4 +1,4 @@
-EXAMPLES-$(CONFIG_AVIO_HTTP_SERVE_FILES)     += avio_http_serve_files
+EXAMPLES-$(CONFIG_AVIO_HTTP_SERVE_FILES_EXAMPLE) += avio_http_serve_files
 EXAMPLES-$(CONFIG_AVIO_LIST_DIR_EXAMPLE)     += avio_list_dir
 EXAMPLES-$(CONFIG_AVIO_READ_CALLBACK_EXAMPLE) += avio_read_callback
 EXAMPLES-$(CONFIG_DECODE_AUDIO_EXAMPLE)      += decode_audio
