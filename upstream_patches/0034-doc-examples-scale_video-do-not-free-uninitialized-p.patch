From de5df1b3b2d702adb47e56259eefdc96f96df055 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 07:08:25 +0000
Subject: [PATCH] doc/examples/scale_video: do not free uninitialized pointers

When sws_getContext() fails, the example jumps to the cleanup code
before the image buffers are allocated and passes the uninitialized
src_data[0] and dst_data[0] to av_freep(). The same happens for
dst_data[0] when the allocation of the source image fails.

Initialize both arrays so that the cleanup code is safe on every path.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 doc/examples/scale_video.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/doc/examples/scale_video.c b/doc/examples/scale_video.c
index cb4da4a..c2fd161 100644
--- a/doc/examples/scale_video.c
+++ b/doc/examples/scale_video.c
@@ -52,7 +52,7 @@ static void fill_yuv_image(uint8_t *data[4], int linesize[4],
 
 int main(int argc, char **argv)
 {
-    uint8_t *src_data[4], *dst_data[4];
+    uint8_t *src_data[4] = { NULL }, *dst_data[4] = { NULL };
     int src_linesize[4], dst_linesize[4];
     int src_w = 320, src_h = 240, dst_w, dst_h;
     enum AVPixelFormat src_pix_fmt = AV_PIX_FMT_YUV420P, dst_pix_fmt = AV_PIX_FMT_RGB24;
-- 
