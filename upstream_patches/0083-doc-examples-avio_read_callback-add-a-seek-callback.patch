From a8caec7f0aae3471001049a51d9355cfe7999e5b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 17:15:40 +0000
Subject: [PATCH 83/84] doc/examples/avio_read_callback: add a seek callback

The example only gives avio_alloc_context() a read callback, so the
resulting AVIOContext is not seekable. Demuxers that need to jump around
in the data cannot work properly then, and the example still reports
success.

An MP4 file that has the moov atom after the mdat atom is the common
case. The demuxer reads the moov atom at the end, but cannot go back to
the samples to probe them:

    stream 0, offset 0x30: partial file
    Could not find codec parameters for stream 0 (Video: h264 (avc1 /
    0x31637661), none, 640x360, 770 kb/s): unspecified pixel format

and the pixel format is printed as "none". MPEG-TS and MP2 files lose
their duration and bitrate ("Duration: N/A"), because these are
estimated from the end of the file. Without seeking, the demuxer also has
to read through the whole mdat atom to get to the moov atom: 138 calls of
the read callback instead of 6 for a 563 kB MP4 file.

Add a seek callback that handles SEEK_SET, SEEK_CUR, SEEK_END and
AVSEEK_SIZE, which is all libavformat needs for data in memory. With it
the MP4 file reports yuv420p and a bitrate, and the MPEG-TS and MP2
files report their duration.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 doc/examples/avio_read_callback.c | 47 +++++++++++++++++++++++++++----
 1 file changed, 41 insertions(+), 6 deletions(-)

diff --git a/doc/examples/avio_read_callback.c b/doc/examples/avio_read_callback.c
index d95b4fe11f..5eb28b0e6c 100644
--- a/doc/examples/avio_read_callback.c
+++ b/doc/examples/avio_read_callback.c
@@ -25,7 +25,9 @@
  * @example avio_read_callback.c
  *
  * Make libavformat demuxer access media content through a custom
- * AVIOContext read callback.
+ * AVIOContext read callback, with a seek callback so that formats that
+ * need to jump around in the data (an MP4 file with the moov atom at
+ * the end, for example) can be demuxed as well.
  */
 
 #include <libavcodec/avcodec.h>
@@ -35,8 +37,10 @@
 #include <libavutil/mem.h>
 
 struct buffer_data {
-    uint8_t *ptr;
-    size_t size; ///< size left in the buffer
+    uint8_t *start;  ///< start of the buffer
+    uint8_t *ptr;    ///< current position in the buffer
+    size_t size;     ///< size left in the buffer
+    size_t total;    ///< size of the whole buffer
 };
 
 static int read_packet(void *opaque, uint8_t *buf, int buf_size)
@@ -56,6 +60,37 @@ static int read_packet(void *opaque, uint8_t *buf, int buf_size)
     return buf_size;
 }
 
+static int64_t seek_buffer(void *opaque, int64_t offset, int whence)
+{
+    struct buffer_data *bd = (struct buffer_data *)opaque;
+    int64_t pos;
+
+    switch (whence & ~AVSEEK_FORCE) {
+    case AVSEEK_SIZE:
+        /* libavformat asks for the size of the data without moving */
+        return bd->total;
+    case SEEK_SET:
+        pos = offset;
+        break;
+    case SEEK_CUR:
+        pos = (bd->ptr - bd->start) + offset;
+        break;
+    case SEEK_END:
+        pos = bd->total + offset;
+        break;
+    default:
+        return AVERROR(EINVAL);
+    }
+
+    if (pos < 0 || pos > (int64_t)bd->total)
+        return AVERROR(EINVAL);
+
+    bd->ptr  = bd->start + pos;
+    bd->size = bd->total - pos;
+
+    return pos;
+}
+
 int main(int argc, char *argv[])
 {
     AVFormatContext *fmt_ctx = NULL;
@@ -80,8 +115,8 @@ int main(int argc, char *argv[])
         goto end;
 
     /* fill opaque structure used by the AVIOContext read callback */
-    bd.ptr  = buffer;
-    bd.size = buffer_size;
+    bd.start = bd.ptr = buffer;
+    bd.size  = bd.total = buffer_size;
 
     if (!(fmt_ctx = avformat_alloc_context())) {
         ret = AVERROR(ENOMEM);
@@ -94,7 +129,7 @@ int main(int argc, char *argv[])
         goto end;
     }
     avio_ctx = avio_alloc_context(avio_ctx_buffer, avio_ctx_buffer_size,
-                                  0, &bd, &read_packet, NULL, NULL);
+                                  0, &bd, &read_packet, NULL, &seek_buffer);
     if (!avio_ctx) {
         av_freep(&avio_ctx_buffer);
         ret = AVERROR(ENOMEM);
-- 
