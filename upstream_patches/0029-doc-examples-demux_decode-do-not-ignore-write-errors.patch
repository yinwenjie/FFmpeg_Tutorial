From b1954947c84b3bd3e1d3b13e09917658256d1592 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 06:36:13 +0000
Subject: [PATCH] doc/examples/demux_decode: do not ignore write errors

The results of fwrite() and fclose() are not checked. When the output
cannot be written, for example because the disk is full, the example
still prints "Demuxing succeeded." and the commands to play the output,
and exits with status 0:

    $ ./demux_decode in.mp4 /dev/full /dev/full; echo $?
    ...
    Demuxing succeeded.
    ...
    0

Check the error indicator of the streams after writing a frame, and
close the files before success is reported, since buffered data is
only written then.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 doc/examples/demux_decode.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/doc/examples/demux_decode.c b/doc/examples/demux_decode.c
index 396056c..04591b4 100644
--- a/doc/examples/demux_decode.c
+++ b/doc/examples/demux_decode.c
@@ -84,6 +84,10 @@ static int output_video_frame(AVFrame *frame)
 
     /* write to rawvideo file */
     fwrite(video_dst_data[0], 1, video_dst_bufsize, video_dst_file);
+    if (ferror(video_dst_file)) {
+        fprintf(stderr, "Error writing to %s\n", video_dst_filename);
+        return AVERROR(EIO);
+    }
     return 0;
 }
 
@@ -111,6 +115,10 @@ static int output_audio_frame(AVFrame *frame)
     } else {
         fwrite(frame->extended_data[0], bps * channels, frame->nb_samples, audio_dst_file);
     }
+    if (ferror(audio_dst_file)) {
+        fprintf(stderr, "Error writing to %s\n", audio_dst_filename);
+        return AVERROR(EIO);
+    }
 
     return 0;
 }
@@ -348,6 +356,27 @@ int main (int argc, char **argv)
     if (audio_stream && (ret = decode_packet(audio_dec_ctx, NULL)) < 0)
         goto end;
 
+    /* close the output files here: the data still buffered is written now,
+     * which can fail as well */
+    if (video_dst_file) {
+        ret = fclose(video_dst_file);
+        video_dst_file = NULL;
+        if (ret == EOF) {
+            fprintf(stderr, "Error writing to %s\n", video_dst_filename);
+            ret = AVERROR(EIO);
+            goto end;
+        }
+    }
+    if (audio_dst_file) {
+        ret = fclose(audio_dst_file);
+        audio_dst_file = NULL;
+        if (ret == EOF) {
+            fprintf(stderr, "Error writing to %s\n", audio_dst_filename);
+            ret = AVERROR(EIO);
+            goto end;
+        }
+    }
+
     printf("Demuxing succeeded.\n");
 
     if (video_stream) {
-- 
