From 05f27e0c3b5a10b084be29761151984fb685b752 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 21:40:03 +0000
Subject: [PATCH] doc/examples: do not replace error codes with AVERROR_UNKNOWN

remux and transcode ignored the return value of
avformat_alloc_output_context2() and reported AVERROR_UNKNOWN when no
context was created, so e.g. an output file name with an unknown
extension ended in

  Error occurred: Unknown error occurred

Use the returned error code, which gives "Invalid argument" in this
case, as qsv_transcode and vaapi_transcode already do. Also return
AVERROR(ENOMEM) when avformat_new_stream() fails, like the other
examples (qsv_transcode, transcode_aac, vaapi_transcode).

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 doc/examples/remux.c     | 7 +++----
 doc/examples/transcode.c | 8 ++++----
 2 files changed, 7 insertions(+), 8 deletions(-)

diff --git a/doc/examples/remux.c b/doc/examples/remux.c
index e377b2c..0bca5fc 100644
--- a/doc/examples/remux.c
+++ b/doc/examples/remux.c
@@ -84,10 +84,9 @@ int main(int argc, char **argv)
 
     av_dump_format(ifmt_ctx, 0, in_filename, 0);
 
-    avformat_alloc_output_context2(&ofmt_ctx, NULL, NULL, out_filename);
-    if (!ofmt_ctx) {
+    ret = avformat_alloc_output_context2(&ofmt_ctx, NULL, NULL, out_filename);
+    if (ret < 0) {
         fprintf(stderr, "Could not create output context\n");
-        ret = AVERROR_UNKNOWN;
         goto end;
     }
 
@@ -123,7 +122,7 @@ int main(int argc, char **argv)
         out_stream = avformat_new_stream(ofmt_ctx, NULL);
         if (!out_stream) {
             fprintf(stderr, "Failed allocating output stream\n");
-            ret = AVERROR_UNKNOWN;
+            ret = AVERROR(ENOMEM);
             goto end;
         }
 
diff --git a/doc/examples/transcode.c b/doc/examples/transcode.c
index 69f880b..76afb32 100644
--- a/doc/examples/transcode.c
+++ b/doc/examples/transcode.c
@@ -136,10 +136,10 @@ static int open_output_file(const char *filename)
     unsigned int i;
 
     ofmt_ctx = NULL;
-    avformat_alloc_output_context2(&ofmt_ctx, NULL, NULL, filename);
-    if (!ofmt_ctx) {
+    ret = avformat_alloc_output_context2(&ofmt_ctx, NULL, NULL, filename);
+    if (ret < 0) {
         av_log(NULL, AV_LOG_ERROR, "Could not create output context\n");
-        return AVERROR_UNKNOWN;
+        return ret;
     }
 
 
@@ -147,7 +147,7 @@ static int open_output_file(const char *filename)
         out_stream = avformat_new_stream(ofmt_ctx, NULL);
         if (!out_stream) {
             av_log(NULL, AV_LOG_ERROR, "Failed allocating output stream\n");
-            return AVERROR_UNKNOWN;
+            return AVERROR(ENOMEM);
         }
 
         in_stream = ifmt_ctx->streams[i];
-- 
