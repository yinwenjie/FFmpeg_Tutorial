From a74c041c6e4eb421767899bd0c13e409324a426d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 06:35:34 +0000
Subject: [PATCH] doc/examples/demux_decode: stop with an error when decoding
 fails

When decode_packet() fails, the read loop is left, the decoders are
flushed and the program goes on to print "Demuxing succeeded." and the
commands to play the output. ret is overwritten on the way, so the exit
status is 0 as well, although only a part of the input was decoded:

    $ ./demux_decode damaged.mp4 v.yuv a.pcm; echo $?
    ...
    Error submitting a packet for decoding (Invalid data found when processing input)
    Demuxing succeeded.
    ...
    0

Errors returned by av_read_frame() other than AVERROR_EOF and errors
while flushing are not noticed at all.

Go to the cleanup code in all these cases. Also flush a decoder only if
its stream is used: the context is allocated before avcodec_open2() is
called, so it can be non-NULL for a decoder that could not be opened.

Co-Authored-By: Claude <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FZ4G6798n6Ua4qu6xwWu3S
---
 doc/examples/demux_decode.c | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/doc/examples/demux_decode.c b/doc/examples/demux_decode.c
index fb9254d..a3a9131 100644
--- a/doc/examples/demux_decode.c
+++ b/doc/examples/demux_decode.c
@@ -318,7 +318,7 @@ int main (int argc, char **argv)
         printf("Demuxing audio from file '%s' into '%s'\n", src_filename, audio_dst_filename);
 
     /* read frames from the file */
-    while (av_read_frame(fmt_ctx, pkt) >= 0) {
+    while ((ret = av_read_frame(fmt_ctx, pkt)) >= 0) {
         // check if the packet belongs to a stream we are interested in, otherwise
         // skip it
         if (pkt->stream_index == video_stream_idx)
@@ -327,14 +327,18 @@ int main (int argc, char **argv)
             ret = decode_packet(audio_dec_ctx, pkt);
         av_packet_unref(pkt);
         if (ret < 0)
-            break;
+            goto end;
+    }
+    if (ret != AVERROR_EOF) {
+        fprintf(stderr, "Error reading from %s (%s)\n", src_filename, av_err2str(ret));
+        goto end;
     }
 
     /* flush the decoders */
-    if (video_dec_ctx)
-        decode_packet(video_dec_ctx, NULL);
-    if (audio_dec_ctx)
-        decode_packet(audio_dec_ctx, NULL);
+    if (video_stream && (ret = decode_packet(video_dec_ctx, NULL)) < 0)
+        goto end;
+    if (audio_stream && (ret = decode_packet(audio_dec_ctx, NULL)) < 0)
+        goto end;
 
     printf("Demuxing succeeded.\n");
 
